public class BasicoJava {
    public static void main(String[] args) {
        //Código voltado a variaveis basicas do Java
        
        // 1. Tipo INT (Números Inteiros)
        int idade = 29;
        int temperatura = -5;

        // Imprimindo os valores na tela
        System.out.println("Idade: " + idade);
        System.out.println("tempertatua: " + temperatura);

        //2. Double
        //double age igual a variavel int, mas, temos uma diferença para que todo numero mesmo nao sendo inteiro esteja no Double
        double valor = 2.15;
        double pagamento = 1200.12;

        // 3. Tipo STRING (Textos)
        // Note que 'String' começa com letra maiúscula em Java
        String nome = "Carlos";
        String cidade = "Santos";

        System.out.println("Nome: " + nome);
        System.out.println("Cidade: " + cidade);

        // 4. Juntando INT com STRING (Concatenação)
        // Em Java, o sinal de mais (+) serve para "colar" textos e números facilmente
        String mensagem = nome + " tem " + idade + " anos e mora em " + cidade + ".";
        
        System.out.println(mensagem);
    }
}
